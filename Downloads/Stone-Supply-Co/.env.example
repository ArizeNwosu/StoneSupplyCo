# ── Site ──────────────────────────────────────────────────────────────────────
# Used for canonical URLs, sitemaps, and OpenGraph metadata.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# ── Supabase ──────────────────────────────────────────────────────────────────
# Public anon key — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — server only, never expose to the browser.
# Used by admin API routes to bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Gemini ────────────────────────────────────────────────────────────────────
# Used by the Stone Finder and Visualizer API routes.
GEMINI_API_KEY=your-gemini-api-key

# ── Admin ─────────────────────────────────────────────────────────────────────
# Bearer token for /api/admin/* routes. Generate with: openssl rand -hex 32
# Keep this secret — never commit it or pass it in URLs.
ADMIN_SECRET=your-admin-secret

# ── OpenAI ────────────────────────────────────────────────────────────────────
# Used by the Stone Visualizer API route for image editing.
OPENAI_API_KEY=your-openai-api-key
