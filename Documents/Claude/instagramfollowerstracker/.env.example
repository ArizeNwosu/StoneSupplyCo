# Database
DATABASE_URL="postgresql://..."

# Auth (NextAuth v5)
AUTH_SECRET="..."
AUTH_URL="https://instagramfollowerstracker.com"
GOOGLE_CLIENT_ID="..."
GOOGLE_CLIENT_SECRET="..."

# Email (Resend)
RESEND_API_KEY="..."
EMAIL_FROM="noreply@instagramfollowerstracker.com"

# Stripe
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_..."
STRIPE_PRICE_PRO_MONTHLY="price_..."
STRIPE_PRICE_PRO_ANNUAL="price_..."
STRIPE_PRICE_AGENCY_MONTHLY="price_..."
STRIPE_PRICE_AGENCY_ANNUAL="price_..."

# Automated Instagram collection (recommended production provider)
APIFY_TOKEN="apify_api_..."
APIFY_ACTOR_ID="apify/instagram-profile-scraper"
SCRAPER_PROVIDER="apify"

# Proxy fallback (optional)
PROXY_URL="http://user:pass@proxy.provider.com:port"

# Cron security
CRON_SECRET="..."

# App
NEXT_PUBLIC_APP_URL="https://instagramfollowerstracker.com"
DIAGNOSTICS_EMAILS="owner@example.com"
ADMIN_EMAIL="owner@example.com"

# Revenue reporting — test accounts are excluded from metrics and outreach
REVENUE_TEST_EMAILS="owner@example.com,test@example.com"

# Lifecycle outreach (safe deployment defaults)
OUTREACH_ENABLED="false"
OUTREACH_DRY_RUN="true"
OUTREACH_ALLOWLIST="owner@example.com"
OUTREACH_TOKEN_SECRET="generate-a-long-random-secret"
OUTREACH_FROM_NAME="Instagram Followers Tracker"
OUTREACH_REPLY_TO="support@example.com"
OUTREACH_COMPANY_ADDRESS="Company name, physical postal address"

# IONOS mailbox — use the full mailbox address as the username
IONOS_EMAIL_USER="support@example.com"
IONOS_EMAIL_PASSWORD="app-or-mailbox-password"
IONOS_SMTP_HOST="smtp.ionos.com"
IONOS_SMTP_PORT="465"
IONOS_IMAP_HOST="imap.ionos.com"
IONOS_IMAP_PORT="993"
