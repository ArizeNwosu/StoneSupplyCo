generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String           @id @default(cuid())
  email            String           @unique
  name             String?
  plan             Plan             @default(FREE)
  stripeCustomerId String?
  stripeSubId      String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  trackedAccounts  TrackedAccount[]
  alerts           Alert[]
  accounts         Account[]
  sessions         Session[]
}

enum Plan {
  FREE
  PRO
  AGENCY
}

model TrackedAccount {
  id          String      @id @default(cuid())
  userId      String
  handle      String
  displayName String?
  avatarUrl   String?
  isPublic    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  lastChecked DateTime?
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  snapshots   Snapshot[]
  alerts      Alert[]

  @@unique([userId, handle])
  @@index([handle])
}

model Snapshot {
  id               String         @id @default(cuid())
  trackedAccountId String
  followerCount    Int
  followingCount   Int?
  postCount        Int?
  takenAt          DateTime       @default(now())
  trackedAccount   TrackedAccount @relation(fields: [trackedAccountId], references: [id], onDelete: Cascade)

  @@index([trackedAccountId, takenAt])
}

model PublicAccount {
  id             String           @id @default(cuid())
  handle         String           @unique
  displayName    String?
  avatarUrl      String?
  bio            String?
  category       String?
  followerCount  Int?
  followingCount Int?
  postCount      Int?
  lastChecked    DateTime?
  createdAt      DateTime         @default(now())
  snapshots      PublicSnapshot[]
}

model PublicSnapshot {
  id              String        @id @default(cuid())
  publicAccountId String
  followerCount   Int
  followingCount  Int?
  postCount       Int?
  takenAt         DateTime      @default(now())
  publicAccount   PublicAccount @relation(fields: [publicAccountId], references: [id], onDelete: Cascade)

  @@index([publicAccountId, takenAt])
}

model Alert {
  id               String         @id @default(cuid())
  userId           String
  trackedAccountId String
  type             AlertType
  threshold        Int?
  lastTriggered    DateTime?
  createdAt        DateTime       @default(now())
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackedAccount   TrackedAccount @relation(fields: [trackedAccountId], references: [id], onDelete: Cascade)
}

enum AlertType {
  GAIN_THRESHOLD
  LOSS_THRESHOLD
  DAILY_SUMMARY
}

// NextAuth required models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
